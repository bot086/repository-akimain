# ─────────────────────────────────────────────
# Akshay Vastrad Portfolio — Environment Config
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# App
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-this-in-production

# Database
# For local dev you can use SQLite:
#   DATABASE_URL=sqlite:///./akkira.db
# For production (Supabase/PostgreSQL):
DATABASE_URL=sqlite:///./akkira.db

# Cloudinary (get from cloudinary.com dashboard)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────
# CONTACT DETAILS — Fill these in!
# ─────────────────────────────────────────────
# WhatsApp number in international format (no spaces, no dashes)
WHATSAPP_NUMBER=918660976964
WHATSAPP_GREETING=Hi+Akshay%2C+I+saw+your+portfolio+and+would+love+to+collaborate%21

CONTACT_EMAIL=akshay@youremail.com
INSTAGRAM_HANDLE=@akshay.vastrad

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://akshay-vastrad.vercel.app
